<%- include('../partials/header') %>
  <div class="container mt-5">
    <h1>User Management</h1>

    <div class="card mb-4">
      <div class="card-body">
        <h5 class="card-title">Izveidot jaunu lietotāju</h5>
        <form action="/admin/users/new" method="POST" class="row g-2 align-items-start">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-md-3">
            <label class="form-label">Lietotājvārds</label>
            <input type="text" name="username" class="form-control" required>
            <div class="form-text">Ar šo lietotājs ielogojas. Nav redzams citiem.</div>
          </div>
          <div class="col-md-3">
            <label class="form-label">Attēlotais vārds</label>
            <input type="text" name="displayName" class="form-control" placeholder="piem. Imants">
            <div class="form-text">Šis vārds redzams pie vērtējumiem, ne login lapā.</div>
          </div>
          <div class="col-md-3">
            <label class="form-label">Pagaidu parole</label>
            <input type="text" name="password" class="form-control" required minlength="6">
            <div class="form-text">Pastāsti to lietotājam, viņš var to vēlāk nomainīt savā profilā.</div>
          </div>
          <div class="col-md-2 form-check ms-2 mt-md-4">
            <input type="checkbox" name="isAdmin" class="form-check-input" id="newUserIsAdmin">
            <label class="form-check-label" for="newUserIsAdmin">Admin</label>
          </div>
          <div class="col-md-1 mt-md-4">
            <button type="submit" class="btn btn-primary w-100">Izveidot</button>
          </div>
        </form>
      </div>
    </div>

    <h5 class="mt-4 mb-3">Lietotāji (<%= users.length %>)</h5>

    <% users.forEach(user=> { %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
          <div>
            <div class="fs-5 fw-semibold">
              <%= user.displayName || user.username %>
              <% if (user.isAdmin) { %>
                <span class="badge bg-success">Admin</span>
                <% } else { %>
                  <span class="badge bg-secondary">Lietotājs</span>
                  <% } %>
                  <% if (user.passwordTemporary) { %>
                    <span class="badge bg-warning text-dark" title="Lietotājam ir admina uzliktā pagaidu parole">pagaidu parole</span>
                    <% } %>
            </div>
            <div class="text-muted small">login: <%= user.username %></div>
          </div>
          <form action="/admin/users/<%= user._id %>/delete" method="POST"
                onsubmit="return confirm('Tiešām dzēst lietotāju &quot;<%= user.username %>&quot;? Šo nevar atsaukt.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline-danger">Dzēst</button>
          </form>
        </div>

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <form action="/admin/users/<%= user._id %>/edit" method="POST" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-6">
                <label class="form-label small mb-1 text-muted">Lietotājvārds (login)</label>
                <input type="text" name="username" class="form-control form-control-sm" value="<%= user.username %>" required>
              </div>
              <div class="col-6">
                <label class="form-label small mb-1 text-muted">Attēlotais vārds (vērtējumos)</label>
                <input type="text" name="displayName" class="form-control form-control-sm" value="<%= user.displayName || '' %>" placeholder="piem. Imants">
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-sm btn-outline-primary">Saglabāt vārdu</button>
              </div>
            </form>
          </div>

          <div class="col-12 col-md-3">
            <form action="/admin/users/<%= user._id %>/reset-password" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="form-label small mb-1 text-muted">Jauna (pagaidu) parole</label>
              <div class="input-group input-group-sm">
                <input type="text" name="password" class="form-control" required minlength="6">
                <button type="submit" class="btn btn-outline-secondary">Atiestatīt</button>
              </div>
            </form>
          </div>

          <div class="col-12 col-md-3 d-flex align-items-end">
            <form action="/admin/users/<%= user._id %>/toggle-admin" method="POST" class="w-100">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-outline-warning w-100">
                <%= user.isAdmin ? 'Noņemt admin tiesības' : 'Piešķirt admin tiesības' %>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <% }) %>

    <a href="/admin/dashboard" class="btn btn-secondary mt-3">Back to Dashboard</a>
  </div>
  <%- include('../partials/footer') %>